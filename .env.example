# Clumsy Cheetah — environment

Copy to `.env.local`. Never commit secrets.

# --- Required for catalog, auth, admin (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used for webhooks, trusted jobs, never imported in client components.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL (sitemap, Open Graph, auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local test accounts only (never production). Used by: npm run seed:test-users
# TEST_USER_PASSWORD=

# --- Phase 8 payments (do not set in the client except key id) ---
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# UPI QR checkout (public payee id shown on the QR — not a card)
NEXT_PUBLIC_UPI_VPA=
NEXT_PUBLIC_UPI_PAYEE_NAME=Clumsy Cheetah

# Free India OTP SMS via 2Factor (no Twilio). Server only.
# TWO_FACTOR_API_KEY=
# TWO_FACTOR_TEMPLATE=OTP1
# SEND_SMS_HOOK_SECRET=

# --- BigQuery warehouse (anita.sharma@clumsycheetah.in) ---
# GCP_PROJECT_ID=
# BIGQUERY_DATASET=commerce
# BIGQUERY_LOCATION=asia-south1
# GOOGLE_APPLICATION_CREDENTIALS=
